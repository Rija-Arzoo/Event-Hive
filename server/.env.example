# Application Environment (development, production, test)
NODE_ENV=

# Network Port
PORT=

# Database Configuration (REQUIRED)
# Example: mongodb://localhost:27017/your-db-name
MONGO_URI=

# Authentication (REQUIRED)
# Provide a strong, random secret key for signing JWTs
JWT_SECRET=

# Client Application URL (CORS / Redirects)
CLIENT_URL=

# Cache / Session Store Configuration
REDIS_URL=